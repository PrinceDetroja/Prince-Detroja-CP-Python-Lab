   "source": [
    "#Generate all pythagorean triples till side<=30\n",
    "def pythagorean_triplet():\n",
    "    for a in range(3,30):\n",
    "        for b in range(a+1,30):\n",
    "            for c in range(b+1,31):\n",
    "                if a**2+b**2==c**2:\n",
    "                    print(a,b,c)\n",
    "pythagorean_triplet()"
   ]
