    "#Print n natural no. in reverse order\n",
    "def reverse_num():\n",
    "    n=int(input(\"Enter a natural number: \"))\n",
    "    for i in range(0,n):\n",
    "        print(n-i,end=\" \")\n",
    "reverse_num()"
