     "text": [
      "Enter angle in degrees:  30\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "sin(x) = 0.4999996169872557\n"
     ]
    }
   ],
   "source": [
    "x = float(input(\"Enter angle in degrees: \"))\n",
    "x = x * 3.14159 / 180  \n",
    "\n",
    "sinx = 0\n",
    "y = 1\n",
    "for i in range(10):  \n",
    "    term = 1\n",
    "    for j in range(1, 2*i+2):\n",
    "        term *= x / j\n",
    "    sinx += y * term\n",
    "    y *= -1\n",
    "\n",
    "print(\"sin(x) =\", sinx)"
   ]
  },
