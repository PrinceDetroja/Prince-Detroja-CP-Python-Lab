   "source": [
    "#Print 24 hours of the day with proper suffix like am, pm, noon and midnight.\n",
    "def time():\n",
    "    print(\"12:00 AM or 12:00 midnight\")\n",
    "    for i in range(1,12):\n",
    "        print(i,\":00 AM\")\n",
    "    print(\"12:00 PM or 12:00 noon\")\n",
    "    for i in range(1,12):\n",
    "        print(i,\":00 PM\")\n",
    "\n",
    "time()"
   ]
