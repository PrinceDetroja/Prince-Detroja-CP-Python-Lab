   "source": [
    "#Print Factorial of given number\n",
    "def factorial():\n",
    "    n=int(input(\"Enter a positive integer: \"))\n",
    "    x=1\n",
    "    for i in range(0,n):\n",
    "        x=x*(n-i)\n",
    "    print(\"Factorial of n =\",x)\n",
    "\n",
    "factorial()"
   ]
