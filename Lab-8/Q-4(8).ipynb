   "source": [
    "names = {\"Prince\",\"Aryan\",\"Ben\",\"Anil\"}\n",
    "A_names = set()\n",
    "B_names = set()\n",
    "for name in names:\n",
    "    if name.startswith(\"A\"):\n",
    "        A_names.add(name)\n",
    "    elif name.startswith(\"B\"):\n",
    "        B_names.add(name)\n",
    "print(A_names)\n",
    "print(B_names)"
   ]
