      "{37, 39, 40, 42, 15, 17, 19, 22, 26, 29}\n",
      "No. less than 30 = 6\n",
      "{15, 17, 19, 22, 26, 29}\n"
     ]
    }
   ],
   "source": [
    "import random\n",
    "s=set()\n",
    "while len(s)<10:\n",
    "    x=random.randint(15,45)\n",
    "    s.add(x)\n",
    "print(s)\n",
    "c=0\n",
    "r=set()\n",
    "for i in s:\n",
    "    if i<30:\n",
    "        c+=1\n",
    "    elif i>35:\n",
    "        r.add(i)\n",
    "s=s-r\n",
    "print(\"No. less than 30 =\",c)\n",
    "print(s)"
   ]
  },
