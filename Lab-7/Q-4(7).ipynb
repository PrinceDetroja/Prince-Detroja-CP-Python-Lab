     "text": [
      "Character frequencies:\n",
      "{'P': 1, 'r': 2, 'i': 1, 'n': 1, 'c': 1, 'e': 2, ' ': 1, 'D': 1, 't': 1, 'o': 1, 'j': 1, 'a': 1}\n"
     ]
