   ],
   "source": [
    "string = input(\"Enter a string: \")\n",
    "char_freq = {}\n",
    "\n",
    "for i in string:\n",
    "    if i in char_freq:\n",
    "        char_freq[i] += 1\n",
    "    else:\n",
    "        char_freq[i] = 1\n",
    "\n",
    "print(\"Character frequencies:\")\n",
    "print(char_freq)"
   ]
