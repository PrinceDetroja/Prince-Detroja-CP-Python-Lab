   "source": [
    "prices = {'apple': 25, 'banana': 5, 'milk': 50}\n",
    "quantities = {'apple': 4,'banana': 6,'milk': 2}\n",
    "total = 0\n",
    "for item in prices:\n",
    "    if item in quantities:\n",
    "        total += prices[item] * quantities[item]\n",
    "\n",
    "print(\"Total bill =\",total,\"rupees\")"
   ]
