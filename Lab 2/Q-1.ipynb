    "#Print largest and smallest values out of 2\n",
    "a=float(input(\"Enter 1st number: \"))\n",
    "b=float(input(\"Enter 2nd number: \"))\n",
    "if a>b:\n",
    "    print(a,\"is largest\")\n",
    "elif a<b:\n",
    "    print(b,\"is largest\")\n",
    "else:\n",
    "    print(a,\"=\",b)"
