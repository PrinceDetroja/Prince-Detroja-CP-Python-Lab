   "source": [
    "#Check if its leap year or not\n",
    "a=int(input(\"Enter year: \"))\n",
    "if a>0 and a%4==0:\n",
    "    print(a,\"is leap year\")\n",
    "elif a>0 and a%4!=0:\n",
    "    print(a,\"is not a leap year\")\n",
    "else:\n",
    "    print(\"Enter a valid year\")"
   ]
