    "def l(x):\n",
    "    lst=[]\n",
    "    for i in range(1,x+1):\n",
    "        t=(i,i**2,i**3)\n",
    "        lst.append(t)\n",
    "    print(lst)\n",
    "x=int(input(\"Enter a number\"))\n",
    "l(x)"
   ]
