   "source": [
    "def isPalindrome(s):\n",
    "    if s.lower()==s.lower()[::-1]:\n",
    "        return True\n",
    "    else:\n",
    "        return False\n",
    "s = input(\"Enter a string\")\n",
    "print(\"Is palindrome:\",isPalindrome(s))"
   ]
