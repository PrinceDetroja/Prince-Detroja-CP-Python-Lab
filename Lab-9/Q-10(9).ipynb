   "source": [
    "def freq(s):\n",
    "    word=s.split()\n",
    "    l={}\n",
    "    for i in word:\n",
    "        i=i.lower()\n",
    "        if i in l:\n",
    "            l[i]+=1\n",
    "        else:\n",
    "            l[i]=1\n",
    "    f=sorted(l.items())\n",
    "    return dict(f)\n",
    "s=input(\"enter a string:\")\n",
    "r=freq(s)\n",
    "print(r)"
   ]
  }
 ],
