   "source": [
    "def count_alpha_digits(s):\n",
    "    l=list(s)\n",
    "    x=0\n",
    "    y=0\n",
    "    for i in l:\n",
    "        if i.isalpha():\n",
    "            x+=1\n",
    "        elif i.isdigit():\n",
    "            y+=1\n",
    "    return(x,y)\n",
    "\n",
    "s=input(\"enter a string:\")\n",
    "x,y=count_alpha_digits(s)\n",
    "d={'alpha':x,'number':y}\n",
    "print(d)"
   ]
  },
