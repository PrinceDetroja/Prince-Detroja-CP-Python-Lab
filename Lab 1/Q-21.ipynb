   "source": [
    "#Calculate net salary where net salary=gross salary + allowance - deduction\n",
    "G=float(input('Enter gross salary: '))\n",
    "A=0.1*G\n",
    "D=0.03*G\n",
    "N=G+A-D\n",
    "print('net salary=',N)"
