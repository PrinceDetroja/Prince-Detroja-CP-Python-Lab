    "#Convert bytes into kb, mb and gb\n",
    "a=float(input('Enter bytes: '))\n",
    "b=a/(10**3)\n",
    "c=a/(10**6)\n",
    "d=a/(10**9)\n",
    "print('kb','=',b)\n",
    "print('mb','=',c)\n",
    "print('gb','=',d)"
