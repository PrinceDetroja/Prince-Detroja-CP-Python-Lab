   "source": [
    "#Convert list of temperature in fahrenhite to celcius.\n",
    "def FtoC():\n",
    "    L_F=[32,0,100,41,77]\n",
    "    L_C=[]\n",
    "    for i in L_F:\n",
    "        x=(i-32)*5/9\n",
    "        L_C.append(x)\n",
    "    print(L_C)\n",
    "\n",
    "FtoC()"
   ]
