    "#A list contains 5 strings. Conert all these strings to uppercase\n",
    "def convert():\n",
    "    l1=[\"Prince\",\"is\",\"persuing\",\"BTech\",\"at PDEU\"]\n",
    "    l2=[]\n",
    "    for i in l1:\n",
    "        x=i.upper()\n",
    "        l2=l2+[x]\n",
    "    print(l2)\n",
    "\n",
    "convert()"
   ]
