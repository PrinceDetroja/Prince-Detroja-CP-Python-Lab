    "#Remove empty tuple(s) from list of tuples\n",
    "def remove():\n",
    "    l=[(22,9,2006),(),(2296,9),(\"Prince\",22),()]\n",
    "    for i in l:\n",
    "        if not i:\n",
    "            l.remove(i)\n",
    "    print(l)\n",
    "\n",
    "remove()"
